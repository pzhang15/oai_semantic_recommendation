{
  "name": "oai-semantic-recommendation-root",
  "private": true,
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^10.9.1"
  },
  "scripts": {
    "arch:pdf": "mmdc -i docs/architecture/diagram.mmd -o docs/architecture/diagram.pdf -b transparent -w 2000 -H 1300",
