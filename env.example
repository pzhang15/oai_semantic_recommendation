###############################################
# Copy to .env and adjust values
###############################################

# --- Environment ---
ENVIRONMENT=local

# --- OpenAI ---
OPENAI_API_KEY=
# Optional
OPENAI_BASE_URL=

# --- Models ---
MODEL_EMBED=text-embedding-3-small
MODEL_PARSER=gpt-4o-mini
MODEL_JUDGE=gpt-4o-mini
BACKEND=numpy

# --- Data paths ---
DATASET_PATH=
INDEX_PATH=data/index.faiss
IDS_PATH=data/ids.json
STATS_PATH=data/stats.json
PARQUET_PATH=data/products.parquet

# --- Search defaults ---
TOP_K_DEFAULT=12
K_RETRIEVE=400
MMR_LAMBDA=0.7
MMR_FINAL_K=200
MMR_CANDIDATES_MAX=120
MMR_SIMILARITY_MODE=vector_then_title
MMR_TITLE_SIM_THRESHOLD=0.85
DEDUP_KEYS=id
VARIANT_KEYS=parent_asin,title_stem,brand
USE_JUDGE_DEFAULT=true

# --- Parser ---
PARSER_TIMEOUT_SECS=8
PARSER_MAX_TOKENS=150
PARSER_RETRIES=0

# --- Deterministic Facets ---
FACETS_MODE=det_llm
FACETS_DET_CONF_THRESHOLD=0.6

# --- Judge baseline ---
JUDGE_TOP_M=20
JUDGE_BATCH_SIZE=8
JUDGE_TIMEOUT_SECS=10
JUDGE_MAX_TOKENS=220
JUDGE_ALPHA=0.5
JUDGE_CACHE_SIZE=4096
JUDGE_CACHE_TTL_SECS=86400
JUDGE_PRICE_TOLERANCE=0.15
JUDGE_RUBRIC_VERSION=v1
JUDGE_CONCURRENCY=3
JUDGE_CIRCUIT_COOLDOWN_SECS=120

# --- Judge gate / guardrails ---
JUDGE_GATE_ENABLE=true
JUDGE_CHEAP_TOP_M=10
JUDGE_FULL_TOP_M=20
JUDGE_MARGIN_SKIP_MIN=0.05
JUDGE_ENTROPY_SKIP_MAX=1.2
JUDGE_ENTROPY_TAU=0.15
JUDGE_JACCARD_SKIP_MIN=0.6
JUDGE_BUDGET_OK_SKIP_MIN=0.8
JUDGE_CATEGORY_OK_SKIP_MIN=0.7
JUDGE_DUP_SKIP_MAX=0.25
JUDGE_TOLERANCE_BUDGET=0.05
JUDGE_GATE_TIMEOUT_SECS=10
JUDGE_COST_PER_REQ_USD_MAX=0.02
JUDGE_DAILY_COST_USD_MAX=10
JUDGE_AVG_TOKENS_PER_ITEM=20
JUDGE_COST_DEGRADE_TO_CHEAP=true
RUBRIC_VERSION=1

# --- Auto-judge policy ---
JUDGE_AUTO_ENABLE=true
JUDGE_AUTO_PAGE1_ONLY=true
JUDGE_AUTO_MIN_SIGNALS=1

# --- Query expansion ---
EXPANSION_ENABLED=true
EXPANSION_MAX_DET=2
EXPANSION_ALLOW_LLM=false
EXPANSION_LLM_MAX=1
EXPANSION_WEIGHT_BASE=1.0
EXPANSION_WEIGHT_DET1=0.8
EXPANSION_WEIGHT_DET2=0.6
EXPANSION_WEIGHT_LLM=0.5
RRF_K=60
EXPANSION_TIME_BUDGET_MS=40
EXPANSION_LEX_ONLY_OVER_BUDGET=true
EXPANSION_DENSE_FOR_DET=false

# --- Outfit composer ---
OUTFIT_SLOTS_DEFAULT=top,bottom,shoes,outerwear,accessories
OUTFIT_REQUIRED_SLOTS=top,bottom,shoes
OUTFIT_MAX_ALTERNATES=2
OUTFIT_CANDIDATES_POOL=60
OUTFIT_MODEL=
OUTFIT_TIMEOUT_SECS=12
OUTFIT_MAX_TOKENS=700
OUTFIT_RETRIES=1
OUTFIT_PRICE_TOLERANCE=0.10
OUTFIT_COLOR_PALETTE_REQUIRED=true

# --- Eval harness ---
EVAL_TIMEOUT_SECS=30
EVAL_DEFAULT_LIMIT=12
EVAL_QPS=2
PRICE_TOLERANCE=0.15

# --- Search quality controls ---
SEARCH_REQUIRE_PRICE_OR_IMAGE=true

# --- Frontend / CORS ---
VITE_API_BASE_URL=
ALLOWED_ORIGINS=

# --- Hybrid retrieval ---
HYBRID_ENABLED=true
HYBRID_DENSE_K=200
HYBRID_LEX_K=200
HYBRID_RRF_K=75

# --- Lexical TF-IDF ---
LEXICAL_MIN_DF=2
LEXICAL_MAX_DF=0.98
LEXICAL_NGRAMS=1,2
LEXICAL_FIELDS=title,brand,categories,features
LEXICAL_WEIGHTS=0.55,0.25,0.10,0.10
TFIDF_PATH=data/tfidf_doc.npz
TFIDF_VEC_PATH=data/tfidf_vectorizer.joblib
TFIDF_IDS_PATH=data/tfidf_ids.json
TFIDF_META_PATH=data/tfidf_meta.json

# --- Result cache ---
RESULT_CACHE_ENABLE=true
RESULT_CACHE_TTL_SECS=900
RESULT_CACHE_SIZE=256


