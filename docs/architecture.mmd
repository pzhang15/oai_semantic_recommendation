%% Semantic Fashion Recs - Architecture (Generated: 2025-10-26) | Dim=1536 | N~826k
%% Legend: cosine via inner product on unit vectors (FAISS IndexFlatIP); temperature=0 when supported; fallback otherwise.

graph LR
  subgraph Client
    C[Web UI / cURL / scripts]
  end

  subgraph FastAPI_App
    Rrouters[routers: search, outfit, debug]
    Core[core: embedding, faiss_store, retriever, filters, rerank (judge), mmr, parser, outfit]
    T[telemetry: timer, counters, costs]
  end

  subgraph LocalStorage
    P[products.parquet]
    I[ids.json]
    S[stats.json]
    F[index.faiss]
  end

  subgraph External
    OAI[OpenAI API\n(Embeddings, Parser, Judge, Composer)]
  end

  C -->|HTTP JSON| Rrouters
  Rrouters --> Core
  Core --> T

  %% Data flows (/search)
  C -->|Query| Core
  Core -->|1) Parser (Structured Outputs)| OAI
  Core -->|2) Embedding| OAI
  OAI -->|vector| Core
  Core -->|3) FAISS search (vector)| F
  F -->|row ids| Core
  Core -->|4) join ids->products| P
  Core -->|5) filters (budget/category/gender/constraints)| Core
  Core -->|6) judge batch (optional)| OAI
  Core -->|7) MMR diversity| Core
  Core -->|/search items| Rrouters

  %% Outfit path
  Core -->|pool (post-filter/judge)| Core
  Core -->|composer LLM (slots)| OAI
  OAI -->|plan| Core
  Core -->|finalize (dedupe, totals)| Core
  Core -->|/outfit slots| Rrouters

  T -->|/debug/stats| Rrouters
